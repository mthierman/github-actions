{
    "name": "github-actions",
    "private": true,
    "type": "module",
    "scripts": {
        "action:esbuild": "esbuild hello-js/action.ts --bundle --platform=node --target=node24 --format=cjs --outfile=hello-js/dist/action.cjs",
        "action:rollup": "rollup --config rollup.config.js",
        "action:rolldown": "rolldown -c rolldown.config.ts",
        "testing:esbuild": "esbuild testing-js/action.ts --bundle --platform=node --target=node24 --format=cjs --outfile=testing-js/dist/action.cjs"
    },
    "devDependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.1",
        "@rollup/plugin-commonjs": "^28.0.9",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "esbuild": "^0.25.11",
        "prettier": "^3.6.2",
        "rolldown": "1.0.0-beta.45",
        "rollup": "^4.52.5",
        "typescript": "^5.9.3"
    }
}
